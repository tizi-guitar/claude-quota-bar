{
  "name": "claude-quota-bar",
  "displayName": "Claude Quota Bar",
  "description": "Claude Code weekly quota in the status bar, with the theoretical uniform pace overlaid on the bar",
  "version": "0.1.0",
  "publisher": "TizzCode",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tizi-guitar/claude-quota-bar.git"
  },
  "bugs": {
    "url": "https://github.com/tizi-guitar/claude-quota-bar/issues"
  },
  "homepage": "https://github.com/tizi-guitar/claude-quota-bar#readme",
  "keywords": ["claude code", "claude", "anthropic", "quota", "status bar", "usage"],
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeQuotaBar.refresh",
        "title": "Claude Quota: refresh now"
      }
    ],
    "configuration": {
      "title": "Claude Quota Bar",
      "properties": {
        "claudeQuotaBar.pollMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "How often (in minutes) to query the usage endpoint. The endpoint is shared with Claude Code: low values lead to 429s and backoff."
        },
        "claudeQuotaBar.barWidth": {
          "type": "number",
          "default": 12,
          "minimum": 4,
          "maximum": 40,
          "description": "Bar width in characters."
        },
        "claudeQuotaBar.showFiveHour": {
          "type": "boolean",
          "default": false,
          "description": "Also show the 5-hour window next to the weekly one."
        },
        "claudeQuotaBar.alignment": {
          "type": "string",
          "enum": ["left", "right"],
          "default": "right",
          "description": "Which side of the status bar to appear on."
        },
        "claudeQuotaBar.priority": {
          "type": "number",
          "default": 100,
          "description": "Priority within the status bar: higher sits further left within its group."
        }
      }
    }
  }
}
